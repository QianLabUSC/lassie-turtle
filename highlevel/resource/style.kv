MDScreen:
    MDBoxLayout:
        orientation: "vertical"
        MDBottomNavigation:
            id: panel
            height: dp(58)
            MDBottomNavigationItem:
                name: "files_control"
                text: "Running robot"
                font_style: "H1"
                icon: "robot-happy-outline"
                MDGridLayout:
                    cols: 3
                    rows: 1
                    MDBoxLayout:
                        spacing: dp(20)
                        padding: dp(20)
                        orientation: "vertical"
                        size_hint_x: 0.7
                        MDBoxLayout:
                            spacing: dp(20)
                            size_hint_y: 0.6
                            size_hint_x: 1
                            radius: [4]
                            orientation: "vertical"
                            MDTabs:
                                id: datafiguretabs
                                tab_hint_x: 0.5
                                on_tab_switch: app.on_tab_switch(*args)
                                Tab:
                                    title: "Force"
                                    MDBoxLayout:
                                        id: rawForcePlot
                                Tab:
                                    title: "Speed"
                                    MDBoxLayout:
                                        id: speedplot
                                Tab:
                                    title: "Position"
                                    MDBoxLayout:
                                        id: positionplot
                    MDBoxLayout:
                        spacing: dp(20)
                        padding: dp(20)
                        orientation: "vertical"
                        size_hint_x: 0.3
                        MDCard:
                            size_hint_y: 0.16
                            size_hint_x: 1
                            orientation: "vertical"
                            adaptive_height: True
                            elevation: 1
                            radius: [4]
                            padding: dp(12)
                            MDBoxLayout:
                                padding: dp(30)
                                MDLabel:
                                    font_style: "H6"
                                    theme_text_color: "Custom"
                                    text_color: color_deep_orange
                                    text: "Trajectories Selection"
                                MDDropDownItem:
                                    id: drop_item
                                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                                    text: "turtle"
                                    on_release: app.menu.open()
                        MDBoxLayout:
                            id: configure_layout
                        MDCard:
                            size_hint_y: 0.1
                            size_hint_x: 1
                            orientation: "vertical"
                            adaptive_height: True
                            elevation: 1
                            radius: [4]
                            padding: dp(12)
                            MDBoxLayout:
                                padding: dp(15)
                                spacing: dp(15)
                                pos_hint: {"center_x": 0.5, "center_y": 0.2}
                                MDBoxLayout:
                                    size_hint_y: 0.6
                                    size_hint_x: 0.4
                                    MDLabel:
                                        font_style: "Subtitle1"
                                        theme_text_color: "Custom"
                                        text_color: color_deep_orange
                                        text: "Real Time Plot"
                                        height: self.texture_size[1]
                                MDBoxLayout:
                                    size_hint_y: 0.6
                                    size_hint_x: 0.4
                                    MDCheckbox:
                                        id: if_real_time_plot
                                        active: True
                                        size_hint: None, None
                                        size: "60dp", "60dp"
                                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        MDCard:
                            size_hint_y: 0.1
                            size_hint_x: 1
                            orientation: "vertical"
                            adaptive_height: True
                            elevation: 1
                            radius: [4]
                            padding: dp(12)
                            MDBoxLayout:
                                padding: dp(15)
                                spacing: dp(15)
                                MDBoxLayout:
                                    size_hint_y: 0.1
                                    MDTextField:
                                        id: filename
                                        size_hint_y: None
                                        size_y: "60dp"
                                        pos_hint: {"center_x": 0.5, "center_y": 1}
                                        hint_text: "File Prefix"
                                        text_color: color_deep_orange
                                        icon_right: "tag-arrow-down"
                                        icon_right_color: color_deep_orange
                                MDBoxLayout:
                                    size_hint_x: 0.1
                                    TooltipMDIconButton:
                                        icon: "file-download"
                                        tooltip_text: "Download experiment data"
                                        theme_text_color: "Custom"
                                        text_color: color_deep_orange
                                        user_font_size: "36sp"
                                        on_press: app.on_download_data()
                                        pos_hint: {"right": 0, "center_y": 0.5}
                        MDCard:
                            size_hint_y: 0.1
                            size_hint_x: 1
                            orientation: "vertical"
                            adaptive_height: True
                            elevation: 1
                            radius: [4]
                            padding: dp(12)
                            MDBoxLayout:
                                padding: dp(15)
                                spacing: dp(15)
                                MDBoxLayout:
                                    size_hint_y: 0.6
                                    size_hint_x: 0.4
                                    MDLabel:
                                        font_style: "Subtitle1"
                                        theme_text_color: "Custom"
                                        text_color: color_deep_orange
                                        text: "Start Collection"
                                        height: self.texture_size[1]
                                MDBoxLayout:
                                    size_hint_y: 0.6
                                    size_hint_x: 0.4
                                    MDSwitch:
                                        id: start_collection
                                        widget_style: "ios"
                                        pos_hint: {"center_x": 1, "center_y": 0.1}
                                        width: dp(30)
                                        height: dp(20)
                                        on_active: app.check_if_start()
