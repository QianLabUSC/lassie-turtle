#:import Window kivy.core.window.Window
#:import Factory kivy.factory.Factory
#:set default_font_size "18sp"
#:set color_deep_orange "DD2C00"
#:set color_deep_orange "455A64"
#:set color_baby_blue "89CFF0"
#:set color_black "000000"

<turtle_tab>:
    MDCard:
        size_hint_x: 1
        orientation: "vertical"
        adaptive_height: True
        elevation: 1
        radius: [4]
        padding: dp(20)
        spacing: dp(15)
        
        # Sweeping Range
        MDBoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            MDLabel:
                size_hint_x: 0.4
                text: "Sweeping range: "
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
            MDLabel:
                id: Variable_1
                size_hint_x: 0.3
                text: "45"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
            MDLabel:
                size_hint_x: 0.3
                text: "(C)"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
        MDSlider:
            id: Slider_1
            size_hint_y: None
            height: dp(40)
            min: 5
            max: 60
            value: 45
            hint: False
            color: color_deep_orange
            on_active: app.on_change_Variable_1()

        # Insertion Depth
        MDBoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            MDLabel:
                size_hint_x: 0.4
                text: "Insertion depth: "
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
            MDLabel:
                id: Variable_2
                size_hint_x: 0.3
                text: "10"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
            MDLabel:
                size_hint_x: 0.3
                text: "(mm)"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
        MDSlider:
            id: Slider_2
            size_hint_y: None
            height: dp(40)
            min: 1
            max: 100
            value: 20
            hint: False
            color: color_deep_orange
            on_active: app.on_change_Variable_2()

        # Penetration Velocity
        MDBoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            MDLabel:
                size_hint_x: 0.4
                text: "Penetration velocity: "
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
            MDLabel:
                id: Variable_3
                size_hint_x: 0.3
                text: "100"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
            MDLabel:
                size_hint_x: 0.3
                text: "(mm/s)"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
        MDSlider:
            id: Slider_3
            size_hint_y: None
            height: dp(40)
            min: 1
            max: 700
            value: 100
            hint: False
            color: color_deep_orange
            on_active: app.on_change_Variable_3()

        # Sweeping Velocity
        MDBoxLayout:
            size_hint_y: None
            height: dp(40)
            spacing: dp(10)
            MDLabel:
                size_hint_x: 0.4
                text: "Sweeping velocity: "
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
            MDLabel:
                id: Variable_4
                size_hint_x: 0.3
                text: "150"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
            MDLabel:
                size_hint_x: 0.3
                text: "(mm/s)"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: color_black
        MDSlider:
            id: Slider_4
            size_hint_y: None
            height: dp(40)
            min: 1
            max: 700
            value: 150
            hint: False
            color: color_deep_orange
            on_active: app.on_change_Variable_4()

        # Trajectory Start/End Coordinates
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(200)
            spacing: dp(10)
            MDLabel:
                text: "Trajectory Start/End Coordinates (in deg)"
                font_style: "Subtitle1"
                halign: "center"
                size_hint_y: None
                height: dp(30)
            MDBoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(10)
                MDLabel:
                    size_hint_x: 0.4
                    text: "Start Gamma (deg):"
                    font_style: "Subtitle1"
                    theme_text_color: "Custom"
                    text_color: color_black
                MDSlider:
                    id: Slider_start_gamma
                    size_hint_x: 0.6
                    min: -45
                    max: 45
                    value: 0
                    hint: False
                    color: color_deep_orange
            MDBoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(10)
                MDLabel:
                    size_hint_x: 0.4
                    text: "Start Theta (deg):"
                    font_style: "Subtitle1"
                    theme_text_color: "Custom"
                    text_color: color_black
                MDSlider:
                    id: Slider_start_theta
                    size_hint_x: 0.6
                    min: -45
                    max: 45
                    value: 0
                    hint: False
                    color: color_deep_orange
            MDBoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(10)
                MDLabel:
                    size_hint_x: 0.4
                    text: "End Gamma (deg):"
                    font_style: "Subtitle1"
                    theme_text_color: "Custom"
                    text_color: color_black
                MDSlider:
                    id: Slider_end_gamma
                    size_hint_x: 0.6
                    min: -45
                    max: 45
                    value: 15
                    hint: False
                    color: color_deep_orange
            MDBoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(10)
                MDLabel:
                    size_hint_x: 0.4
                    text: "End Theta (deg):"
                    font_style: "Subtitle1"
                    theme_text_color: "Custom"
                    text_color: color_black
                MDSlider:
                    id: Slider_end_theta
                    size_hint_x: 0.6
                    min: -45
                    max: 45
                    value: 15
                    hint: False
                    color: color_deep_orange

